    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an assistant that filters and structures tech event listings.\n\nClassify the following event. It is RELEVANT only if it is one of:\n- an AI/ML hackathon\n- an algorithmic or competitive-coding challenge\n- a tech meetup\n\nIf it is anything else, set isRelevant to false and category to \"Other\".\nExtract the registration link, dates, and any required/featured tech stacks.\n\nEvent data (JSON):\n{{ JSON.stringify($json) }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "3ed849eb-6ba7-40a6-8e4f-5c97c60d7692",
      "name": "Classify & Extract",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        672,
        112
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-haiku-4-5-20251001",
          "cachedResultName": "Claude Haiku 4.5"
        },
        "options": {}
      },
      "id": "1bc9f0fd-e58b-44e9-b8c2-ad2856170ef4",
      "name": "Claude Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        448,
        304
      ],
      "credentials": {
        "anthropicApi": {
          "id": "A01CuBGTsatBl6iI",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"isRelevant\": {\n      \"type\": \"boolean\",\n      \"description\": \"True only if the event is an AI/ML hackathon, an algorithmic/coding challenge, or a tech meetup. False for anything else.\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"AI Hackathon\",\n        \"Algorithmic Challenge\",\n        \"Tech Meetup\",\n        \"Other\"\n      ],\n      \"description\": \"The best-fitting category for this event.\"\n    },\n    \"title\": {\n      \"type\": \"string\",\n      \"description\": \"Event title.\"\n    },\n    \"registrationLink\": {\n      \"type\": \"string\",\n      \"description\": \"URL to register / event page.\"\n    },\n    \"dates\": {\n      \"type\": \"string\",\n      \"description\": \"Human-readable date or date range for the event.\"\n    },\n    \"techStacks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Required or featured technologies/tech stacks for the event (e.g. Python, React, LLMs). Empty array if none stated.\"\n    }\n  },\n  \"required\": [\n    \"isRelevant\",\n    \"category\",\n    \"title\",\n    \"registrationLink\",\n    \"dates\",\n    \"techStacks\"\n  ]\n}"
      },
      "id": "d8a87c9d-c075-4d06-9b1d-ef4f48e91008",
      "name": "Event Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        816,
        336
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-relevant",
              "leftValue": "={{ $json.output.isRelevant }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "abd75481-7194-4d48-b0c4-be471e1fe33a",
      "name": "Only Relevant",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1024,
        112
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "databasePage",
        "databaseId": {
          "__rl": true,
          "value": "3d86a1b0-08b3-80dc-9665-f54e796d8867",
          "mode": "list",
          "cachedResultName": "hackathon-finder",
          "cachedResultUrl": "https://app.notion.com/p/3d86a1b008b380dc9665f54e796d8867"
        },
        "title": "={{ $json.output.title }}",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Category|select",
              "selectValue": "={{ $json.output.category }}"
            },
            {
              "key": "Registration Link|url",
              "urlValue": "={{ $json.output.registrationLink }}"
            },
            {
              "key": "Dates|rich_text",
              "textContent": "={{ $json.output.dates }}"
            },
            {
              "key": "Tech Stacks|rich_text",
              "textContent": "={{ $json.output.techStacks.join(\", \") }}"
            }
          ]
        },
        "options": {}
      },
      "id": "55758bc3-b9c1-454f-93e4-21a5f7ccbb22",
      "name": "Add to Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        1248,
        112
      ],
      "credentials": {
        "notionOAuth2Api": {
          "id": "DUMr5z4SPHNg9PB8",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const relevant = $('Only Relevant').all();\nconst lines = relevant.map(i => {\n  const o = i.json.output || {};\n  const stacks = Array.isArray(o.techStacks) && o.techStacks.length ? o.techStacks.join(', ') : 'n/a';\n  return `• ${o.title} (${o.category}) — ${o.dates}\n  Register: ${o.registrationLink}\n  Tech: ${stacks}`;\n});\nconst count = lines.length;\nconst summary = count ? lines.join('\\n\\n') : 'No new relevant events found.';\nreturn [{ json: { count, summary } }];"
      },
      "id": "a4f0c1b2-2d3e-4f5a-9b6c-1e2f3a4b5c6d",
      "name": "Build Summary",
